# 复制成 .env.local 后填写（.env.local 已被 .gitignore 忽略）。
#
# GitHub OAuth App 的 Client ID。它是公开信息，不是 client_secret。
VITE_GITHUB_CLIENT_ID=

# OAuth Device Flow 代理地址。
# 本地开发用 npm run auth:proxy 时填 http://127.0.0.1:8787；
# 线上填 Cloudflare Worker 地址，例如 https://xcpc-daily-auth.example.workers.dev。
VITE_GITHUB_AUTH_PROXY=http://127.0.0.1:8787
